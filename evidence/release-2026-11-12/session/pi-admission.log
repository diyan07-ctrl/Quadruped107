"$PY" - <<'PY'
import urllib.request,json,base64,pathlib
root=pathlib.Path('.')
state=json.load(urllib.request.urlopen('http://127.0.0.1:7000/api/state',timeout=4))
(root/'admission-state.json').write_text(json.dumps(state,indent=2))
print(json.dumps({k:state[k] for k in ('camera','bridge','motion','sensors')}))
frame=json.load(urllib.request.urlopen('http://127.0.0.1:7000/qualification/frame',timeout=4))
if frame.get('available'):
    for key,name in [('rawPng','yellow-latest-raw.png'),('annotatedJpeg','yellow-latest-opencv.jpg')]:
        (root/name).write_bytes(base64.b64decode(frame[key]))
    for key in ('rawPng','rawJpeg','annotatedJpeg','maskPng'): frame.pop(key,None)
    (root/'yellow-latest-frame.json').write_text(json.dumps(frame,indent=2))
PY

