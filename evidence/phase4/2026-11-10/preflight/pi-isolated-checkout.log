import sys,cv2,numpy,flask,serial,quadruped,json
from importlib.metadata import version, requires
from packaging.requirements import Requirement
from packaging.version import Version
checks=[]
for package in ['Flask','pyserial']:
    for text in requires(package) or []:
        dep=Requirement(text)
        if dep.marker is None or dep.marker.evaluate():
            installed=version(dep.name)
            checks.append(dict(package=package,dependency=dep.name,version=installed,ok=Version(installed) in dep.specifier))
print(json.dumps(dict(python=sys.version,cv2=cv2.__version__,numpy=numpy.__version__,flask=version('Flask'),serial=version('pyserial'),application=quadruped.__file__,dependencies=checks),indent=2))
assert all(check['ok'] for check in checks)
PYCHECK

