* text=auto
LICENSE text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ino text eol=lf
*.h text eol=lf
*.stl binary
*.step -text
*.f3z binary
*.xlsx binary
*.zip binary
*.png binary
*.webp binary
*.jpeg binary
*.mp4 binary
# Preserve original source/assets exactly when moving them between directories.
firmware/uno/sketch/* -text
software/pi/quadruped/web/** -text
archive/uno-q/** -text
software/pi/quadruped/vision.py -text whitespace=cr-at-eol

# Foreground Linux launch scripts must retain LF on Windows checkouts.
*.sh text eol=lf

# Qualification manifests hash exact retained evidence bytes.
evidence/phase4/** -text whitespace=cr-at-eol
# Native command logs retain their original terminal alignment/padding.
evidence/phase4/**/*.log -whitespace
evidence/release-2026-11-12/** -text whitespace=cr-at-eol
evidence/release-2026-11-12/**/*.log -whitespace
